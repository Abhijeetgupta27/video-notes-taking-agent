# copy to .env and fill in. RABBITMQ_URL / REDIS_URL are set in docker-compose.yml already.

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# global limits shared by all workers. keep them a bit UNDER your provider's real limits
LLM_RPM=25
LLM_TPM=10000
LLM_MAX_TOKENS=4000
LLM_REASONING_EFFORT=low
CHUNK_CHARS=9000

# --- Notion public integration (OAuth) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# optional: fixed default destination. if empty, a page titled NOTION_DEFAULT_PAGE_TITLE is used
NOTION_DEFAULT_PARENT_ID=
NOTION_DEFAULT_PAGE_TITLE=Video Notes
NOTION_RPS=3

# --- retries / DLQ ---
MAX_ATTEMPTS=5
RETRY_DELAYS=10,30,90
CRASH_LIMIT=3

# --- pipeline ---
MAX_VIDEO_SEC=1200
MAX_FRAMES=8
YT_RPM=30
# YT_PROXY=http://user:pass@host:port
# YT_COOKIES=/app/cookies.txt

# any random string, used to encrypt the notion token inside queue messages
TOKEN_SECRET=please-change-this

# --- demo helpers (leave empty normally) ---
# CHAOS_429=llm:0.3,notion:0.2,youtube:0.1
# FRAME_DELAY=4
